{
  "name": "temp-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n functions,vite -c yellow,cyan \"netlify functions:serve --port 9999\" \"vite\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "update-data": "ts-node scripts/update-rules.ts && ts-node scripts/update-meta.ts && ts-node scripts/update-tournaments.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && npx gh-pages -d dist",
    "deploy:netlify": "VITE_BASE=/ npm run build && netlify deploy --prod --dir=dist",
    "deploy:netlify:draft": "VITE_BASE=/ npm run build && netlify deploy --dir=dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@smogon/calc": "^0.11.0",
    "openai": "^6.39.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "netlify-cli": "^26.0.2",
    "pokemon-showdown": "github:smogon/pokemon-showdown",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
